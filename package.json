{
  "name": "devotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @devotchi/shared build",
    "build:broker": "pnpm --filter @devotchi/broker build",
    "build:mcp": "pnpm --filter @devotchi/mcp-server build",
    "build:sim": "pnpm --filter @devotchi/simulator build",
    "broker": "node packages/broker/dist/index.js",
    "mcp-server": "node packages/mcp-server/dist/index.js",
    "sim": "pnpm --filter @devotchi/simulator dev"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  }
}
