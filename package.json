{
  "name": "devotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @devotchi/shared build && pnpm --filter @devotchi/server --filter devotchi build",
    "build:shared": "pnpm --filter @devotchi/shared build",
    "build:server": "pnpm --filter @devotchi/server build",
    "build:client": "pnpm --filter devotchi build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run build:shared && tsc -p packages/server --noEmit && tsc -p packages/client --noEmit && tsc -p packages/client/web && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "server": "node packages/server/dist/index.js",
    "client": "node packages/client/dist/cli.js",
    "dev": "pnpm --filter devotchi dev",
    "pet-sheet": "pnpm run build:shared && node packages/shared/scripts/pet-sheet.mjs"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  }
}
