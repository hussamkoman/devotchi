{
  "name": "devotchi",
  "version": "0.1.0",
  "private": true,
  "description": "Desk pet for AI coding agents: CLI, MCP server, Claude Code hook setup, local dashboard and embedded server",
  "license": "MIT",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "devotchi": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && tsc -p web && node scripts/bundle.mjs && vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@koa/router": "^13.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "commander": "^13.0.0",
    "koa": "^2.16.4",
    "open": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@devotchi/server": "workspace:*",
    "@devotchi/shared": "workspace:*",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^21.0.4",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
