{
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__devotchi__show_status",
      "mcp__devotchi__notify",
      "mcp__devotchi__set_mood"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [{
          "type": "http",
          "url": "http://localhost:8080/hook/permission?code=666WQW",
          "timeout": 310
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [{
          "type": "http",
          "url": "http://localhost:8080/hook/status?code=666WQW",
          "timeout": 5
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "http",
          "url": "http://localhost:8080/hook/stop?code=666WQW",
          "timeout": 5
        }]
      }
    ]
  }
}
