CompileFlags:
  # Read per-file flags from build/compile_commands.json (generated by idf.py build).
  CompilationDatabase: build

  # Strip xtensa-gcc-only flags clangd doesn't understand. Be specific instead of -f*/-m*
  # so legitimate flags (like -fno-rtti, -fno-exceptions) survive.
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap

Diagnostics:
  # Suppress false positives clangd reports on ESP-IDF / FreeRTOS headers.
  Suppress:
    - attribute_not_type_attr
