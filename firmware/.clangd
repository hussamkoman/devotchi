CompileFlags:
  CompilationDatabase: build

  # xtensa-gcc flags that clangd does not understand.
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap

Diagnostics:
  # False positives on ESP-IDF / FreeRTOS headers.
  Suppress:
    - attribute_not_type_attr
