# Target: ESP32-S3-MINI-1-N4R2 (4 MB flash, 2 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The image must stay below 1.9 MB so two OTA slots remain possible in 4 MB.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# USB-Serial-JTAG is the board's only connector and the debug console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# DFS is configured by the power component (esp_pm_configure), not at startup.
CONFIG_PM_ENABLE=y

# The CHRG edge ISR runs from the IRAM GPIO ISR service (installed by the
# button library) and calls gpio_intr_disable() as its storm guard.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# LVGL: RGB565 in native byte order (the panel is set to little-endian data).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_USE_LOG=n
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_UNSCII_16=y

# Library allocations go to PSRAM; internal RAM is kept for WiFi, stacks and DMA.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Bluetooth (NimBLE) for WiFi provisioning, protocomm security 1.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# A WebSocket send does not wait for a read in progress.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
