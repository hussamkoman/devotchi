# Target chip
CONFIG_IDF_TARGET="esp32s3"

# Flash — ESP32-S3-MINI-1-N4R2 has 4MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# PSRAM — N4R2 has 2MB QSPI PSRAM (verify mode against module datasheet if you swap variants)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# C++ — exceptions on (allows std::optional, std::variant to throw on misuse)
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# 1ms FreeRTOS ticks → snappier UI/button polling
CONFIG_FREERTOS_HZ=1000

# Power management — required for light sleep to work
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Bigger main stack — C++ stdlib + ArduinoJson eats stack quickly
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Default log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL — RGB565, native byte order (panel is configured LCD_RGB_DATA_ENDIAN_LITTLE)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Bluetooth — required for BLE wifi provisioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# WiFi provisioning over BLE
CONFIG_WIFI_PROV_SCHEME_BLE=y
CONFIG_WIFI_PROV_AUTOSTOP_FROM_PROV_APP=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
